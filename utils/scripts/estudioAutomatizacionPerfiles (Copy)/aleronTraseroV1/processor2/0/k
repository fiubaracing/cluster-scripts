        type            zeroGradient;
    }
    e423_0
    {
        type            kqRWallFunction;
        value           nonuniform 0();
    }
    procBoundary2to1
    {
        type            processor;
        value           uniform 0.4607895938;
    }
    procBoundary2to3
    {
        type            processor;
        value           uniform 0.4607895938;
    }
