FoamFile
{
    version     2.0;
    format      binary;
    class       volVectorField;
    arch        "LSB;label=32;scalar=64";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];


internalField   uniform ( 11.085 0 0 );

boundaryField
{
    Inlet
    {
        type            uniformFixedValue;
        inputValue      nonuniform 0();
        value           nonuniform 0();
        uniformValue    constant ( 11.085 0 0 );
    }
    Outlet
    {
        type            pressureVelocity;
        refValue        uniform ( 0 0 0 );
        refGradient     uniform ( 0 0 0 );
        valueFraction   uniform ( 0 0 0 0 0 0 );
        value           uniform ( 0 0 0 );
        directionSpecification patchNormal;
    }
    Back
    {
        type            empty;
    }
    Front
    {
        type            empty;
    }
    Bottom
    {
        type            slip;
        inputValue      uniform ( 0 0 0 );
        value           uniform ( 11.085 0 0 );
    }
    Top
    {
        type            slip;
        inputValue      uniform ( 0 0 0 );
        value           uniform ( 11.085 0 0 );
    }
    e423_0
    {
        type            wallVelocity;
        inputValue      nonuniform 0();
        value           nonuniform 0();
    }
    procBoundary3to2
    {
        type            processor;
        value           uniform ( 11.085 0 0 );
    }
}


