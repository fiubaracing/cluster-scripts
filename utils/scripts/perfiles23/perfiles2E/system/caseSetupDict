                        value uniform 0.001;
                    }
                }
                Inlet
                {
                    U
                    {
                        type uniformFixedValue;
                        value uniform ( 0.0 0.0 0.0 );
                        uniformValue constant ( 16.67 0.0 0.0 );
                    }
                    p
                    {
                        type fixedFluxPressure;
                        value uniform 0.0;
                    }
                    k
                    {
                        type turbulentIntensityKineticEnergyInlet;
                        value uniform 0.1;
                        intensity 0.05;
                    }
                    omega
                    {
                        type turbulentMixingLengthFrequencyInlet;
                        value uniform 0.01;
                        mixingLength 0.01;
                    }
                    nut
                    {
                        type calculated;
                        value uniform 0.001;
                    }
                }
                Bottom
