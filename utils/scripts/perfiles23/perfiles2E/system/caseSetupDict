FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    location system;
    object caseSetupDict;
}
    global
    {
        modificationSwitches
        {
            resetInternalFields true;
            resetBoundaryFields true;
            resetSystemDicts true;
            resetConstDicts true;
            resetBoundaryMesh true;
            deleteUnusedFields true;
            reuseExistingDicts false;
            strictPatchNameChecking false;
        }
        system
        {
            controlDict
            {
                application helyxSolve;
                startFrom latestTime;
                startTime 0;
                stopAt endTime;
                endTime 3000.0;
                deltaT constant 1.0;
                writeControl timeStep;
                writeInterval 100;
                purgeWrite 0;
                writeFormat binary;
                writePrecision 10;
                writeCompression uncompressed;
                writeEndTime true;
                timeFormat general;
                timePrecision 6;
                graphFormat raw;
                runTimeModifiable yes;
                libs ( "" );
                adjustTimeStep false;
                maxCo 0;
                maxAlphaCo 0;
                minDeltaT 0;
                maxDeltaT 0;
            }
            meshObjects
            {
            }
        }
        functions
        {
            FP
            {
                type fieldProcess;
                regions ( region0 );
                executeControl runTime;
                executeInterval 1.0;
                writeControl onEnd;
                operations
                (
                    {
                        operation yPlus;
                        fieldName yPlus;
                        shearField tauw;
                        write true;
                        nearCellValue false;
                    }
                );
                functionObjectLibs ("libfieldFunctionObjects.so");
            }
            fuerzaMainPlane
            {
                type forces;
                regions ( region0 );
                patches ( mainPlane );
                CofR ( 0.0 0.0 0.0 );
                rhoName rho;
                pRef 0.0;
                writeControl timeStep;
                writeInterval 100;
                executeControl timeStep;
                executeInterval 100;
                functionObjectLibs ("libforces.so" );
            }
            fuerzaflap1
            {
                type forces;
                regions ( region0 );
                patches ( flap1 );
                CofR ( 0.0 0.0 0.0 );
                rhoName rho;
                pRef 0.0;
                writeControl timeStep;
                writeInterval 100;
                executeControl timeStep;
                executeInterval 100;
                functionObjectLibs ("libforces.so" );
            }
            LD
            {
                type liftDrag;
                regions ( region0 );
                patches ( flap1 mainPlane );
                porosity true;
                nAveragingSteps 1;
                outputRegionData true;
                liftDirection ( 0.0 -1.0 0.0 );
                dragDirection ( 1.0 0.0 0.0 );
                Uinf ( 16.67 0.0 0.0 );
                Pref 0.0;
                rhoInf 1.205;
                referenceArea 1.0;
                referenceLength 0.8;
                referencePoint ( 0.0 0.0 0.0 );
                wheelbase 1.0;
                cOfPressure true;
                binData
                {
                    nBins 100;
                    axis ( 1.0 0.0 0.0 );
                }
                writeControl timeStep;
                writeInterval 100;
                executeControl timeStep;
                executeInterval 100;
                functionObjectLibs ("libforces.so" );
            }
            fuerzaTotal
            {
                type forces;
                regions ( region0 );
                patches ( flap1 mainPlane );
                CofR ( 0.0 0.0 0.0 );
                rhoName rho;
                pRef 0.0;
                writeControl timeStep;
                writeInterval 100;
                executeControl timeStep;
                executeInterval 100;
                functionObjectLibs ("libforces.so" );
            }
        }
    }
    regions
    {
        region0
        {
            state (steady ras);
            boundaryMesh
            {
                Outlet
                {
                    type outlet;
                }
                Inlet
                {
                    type inlet;
                }
                Bottom
                {
                    type wall;
                }
                Top
                {
                    type wall;
                }
                flap1
                {
                    type wall;
                }
                mainPlane
                {
                    type wall;
                }
                bottomEmptyFaces
                {
                    type empty;
                }
                topEmptyFaces
                {
                    type empty;
                }
            }
            turbulenceModel kOmegaSST;
            materials (air);
            materialProperties
            {
                air
                {
                    materialName air;
                    materialType fluid;
                    molWeight 28.96;
                    energy sensibleInternalEnergy;
                    equationOfState rhoConst;
                    equationOfStateCoeffs
                    {
                        rho 1.205;
                    }
                    muModel scalarFunction1;
                    muModelCoeffs
                    {
                        mu constant 1.846E-5;
                    }
                    thermodynamics hConst;
                    thermodynamicsCoeffs
                    {
                        Hf 0.0;
                        Cp 1004.9;
                    }
                    kappaModel scalarFunction1;
                    kappaModelCoeffs
                    {
                        kappa 0.0262;
                    }
                    wconcentrationTransport
                    {
                        D [0 2 -1 0 0 0 0] 2.0E-5;
                        Sct 0.6;
                        Cp [0 2 -2 -1 0 0 0] 1930.0;
                    }
                    buoyancyModelCoeffs
                    {
                        beta 0.0034;
                    }
                    referenceFields
                    {
                        p [1 -1 -2 0 0 0 0] 101325.0;
