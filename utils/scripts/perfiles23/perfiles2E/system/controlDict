FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    location system;
    object controlDict;
}
    startFrom latestTime;
    stopAt endTime;
    endTime 3000.0;
    deltaT constant 1.0;
    adjustTimeStep false;
    maxCo 0;
    maxAlphaCo 0;
    minDeltaT 0;
    maxDeltaT 0;
    writeControl timeStep;
    writeInterval 100;
    purgeWrite 0;
    writeFormat binary;
    writeCompression uncompressed;
    writePrecision 10;
    timeFormat general;
    timePrecision 6;
    graphFormat raw;
    runTimeModifiable yes;
    functions
    {
        FP
        {
            type fieldProcess;
            regions ( region0 );
            executeControl runTime;
            executeInterval 1.0;
            writeControl onEnd;
            operations
            (
                {
                    operation yPlus;
                    fieldName yPlus;
                    shearField tauw;
                    write true;
                    nearCellValue false;
                }
            );
            functionObjectLibs ("libfieldFunctionObjects.so");
        }
        fuerzaMainPlane
        {
            type forces;
            regions ( region0 );
            patches ( );
            CofR ( 0.0 0.0 0.0 );
            rhoName rho;
            pRef 0.0;
            writeControl timeStep;
            writeInterval 100;
            executeControl timeStep;
            executeInterval 100;
            functionObjectLibs ("libforces.so" );
        }
        fuerzaflap1
        {
            type forces;
            regions ( region0 );
            patches ( );
            CofR ( 0.0 0.0 0.0 );
            rhoName rho;
            pRef 0.0;
            writeControl timeStep;
            writeInterval 100;
            executeControl timeStep;
            executeInterval 100;
            functionObjectLibs ("libforces.so" );
        }
        LD
        {
            type liftDrag;
            regions ( region0 );
            patches ( );
            porosity true;
            nAveragingSteps 1;
            outputRegionData true;
            liftDirection ( 0.0 -1.0 0.0 );
            dragDirection ( 1.0 0.0 0.0 );
            Uinf ( 16.67 0.0 0.0 );
            Pref 0.0;
            rhoInf 1.205;
            referenceArea 1.0;
            referenceLength 0.8;
            referencePoint ( 0.0 0.0 0.0 );
            wheelbase 1.0;
            cOfPressure true;
            binData
            {
                nBins 100;
                axis ( 1.0 0.0 0.0 );
            }
            writeControl timeStep;
            writeInterval 100;
            executeControl timeStep;
            executeInterval 100;
            functionObjectLibs ("libforces.so" );
        }
        fuerzaTotal
        {
            type forces;
            regions ( region0 );
            patches ( );
            CofR ( 0.0 0.0 0.0 );
            rhoName rho;
            pRef 0.0;
            writeControl timeStep;
            writeInterval 100;
            executeControl timeStep;
            executeInterval 100;
            functionObjectLibs ("libforces.so" );
        }
    }
    application helyxSolve;

