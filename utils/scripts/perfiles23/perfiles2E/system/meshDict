                thicknessRatio 1.3;
                maxFirstLayerThickness 2.0E-5;
                allowDiscontinuity true;
            }
            flap1
            {
                nLayers 10;
                thicknessRatio 1.3;
                maxFirstLayerThickness 2.0E-5;
                allowDiscontinuity true;
