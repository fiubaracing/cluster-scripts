#!/bin/bash

#------------------------------------------------------------------------------
# SLURM Directives
# DO NOT EDIT THESE SETTINGS
#------------------------------------------------------------------------------

# Job name
#SBATCH --job-name="{{ JOB_NAME }}"

# Number of nodes
#SBATCH --nodes={{ NODES }}

# Total number of MPI ranks (nodes * cores/node)
#SBATCH --ntasks={{ TASKS }}

# Cores per node
#SBATCH --ntasks-per-node={{ TASKS_PER_NODE }}

# Standard output log
#SBATCH --output={{ OUTPUT }}

# Standard error log
#SBATCH --error={{ OERROR }}

# Email notifications (NONE, BEGIN, END, FAIL, ALL)
#SBATCH --mail-type=ALL

# Email address
#SBATCH --mail-user={{ EMAIL }}

# Send SIGTERM to the batch script 5 minutes before the time limit,
# so the exit trap has time to stage out results and clean up.
#SBATCH --signal=B:TERM@300

#------------------------------------------------------------------------------
# Environment Setup
#------------------------------------------------------------------------------
echo "Job started on $(date)"
echo "Running on nodes: $SLURM_JOB_NODELIST using $SLURM_NTASKS tasks"

LOCAL_STORAGE_PATH="/tmp/shm"

# Unique directory for this job on the node-local storage
LOCAL_CASE_DIR="$LOCAL_STORAGE_PATH/job_$SLURM_JOB_ID"
WDIR="$SLURM_SUBMIT_DIR"
SECONDS=0

# Set by the pre-solve / stage-out sections
STAGE_IN_DONE=no
STAGE_OUT_DONE=no

cd "$WDIR"

# Load the GCC 13 runtime HELYX was built with (only the compiler: HELYX
# brings its own Open MPI 4.0.2 through activeBuild.shrc)
command -v module >/dev/null 2>&1 || source /etc/profile.d/lmod.sh
module purge
module load gnu13

# Source HELYX before "set -e": environment scripts often run commands that
# return non-zero internally, which would silently kill the job under set -e.
source /mnt/cfd/tools/Engys/HELYXcore-4.4.1/platforms/activeBuild.shrc

set -e

#------------------------------------------------------------------------------
# Stage-out: copy results from every node back to the shared case directory.
# Called after helyxSolve, and from the exit trap if the job ends early
# (solver failure, time limit, scancel -b -s TERM).
#------------------------------------------------------------------------------
stage_out() {
    echo "Staging-Out results to $WDIR $(date)"
    if srun -N "$SLURM_NNODES" --ntasks-per-node=1 \
            bash "$WDIR/pipeline/send_results.sh" "$WDIR" "$LOCAL_CASE_DIR"; then
        STAGE_OUT_DONE=yes
        echo "Finished send results to master $(date)"
    else
        echo "Stage-out FAILED $(date)" >&2
        return 1
    fi
}

#------------------------------------------------------------------------------
# Fallback: retrieve at least the logs from the first node
#------------------------------------------------------------------------------
retrieve_logs_to_master() {
    # The batch script always runs on the first node of the allocation
    if [ -d "$LOCAL_CASE_DIR" ]; then
        echo "[Node ${SLURM_NODEID:-0}] Retrieving logs to master node..."
        [ -d "$LOCAL_CASE_DIR/postProcessing" ] && rsync -rlt "$LOCAL_CASE_DIR/postProcessing" "$WDIR/"
        compgen -G "$LOCAL_CASE_DIR/log.*" >/dev/null && rsync -rlt "$LOCAL_CASE_DIR"/log.* "$WDIR/"
        echo "[Node ${SLURM_NODEID:-0}] Logs retrieval complete."
    fi
}

#------------------------------------------------------------------------------
#  Cleanup local temp directories on all nodes
#------------------------------------------------------------------------------
remove_local_case_dir() {
    # Keep the local copies if the results could not be copied back
    if [ "$STAGE_IN_DONE" = yes ] && [ "$STAGE_OUT_DONE" != yes ]; then
        echo "[Node ${SLURM_NODEID:-0}] Stage-out did not complete: keeping $LOCAL_CASE_DIR on $SLURM_JOB_NODELIST for manual recovery"
        return
    fi
    echo "[Node ${SLURM_NODEID:-0}] Cleaning up local case directory on all nodes..."
    # One task per node; ${VAR:?} aborts instead of running "rm -rf" on an empty path
    srun -N "$SLURM_NNODES" --ntasks-per-node=1 rm -rf "${LOCAL_CASE_DIR:?}"
    echo "[Node ${SLURM_NODEID:-0}] Local case directory removed."
}

#------------------------------------------------------------------------------
# Gather metrics
#------------------------------------------------------------------------------
gather_metrics() {
    echo "Job ended on $(date)"
    TOTAL_RUNTIME=$SECONDS

    hours=$(( TOTAL_RUNTIME / 3600 ))
    minutes=$(( (TOTAL_RUNTIME % 3600) / 60 ))
    seconds=$(( TOTAL_RUNTIME % 60 ))

    printf "Runtime duration: %02dh %02dm %02ds\n" "$hours" "$minutes" "$seconds"
}

#------------------------------------------------------------------------------
# Exit handling: always try to bring the results back, success or not
#------------------------------------------------------------------------------
on_exit() {
    rc=$?
    set +e          # a failing step must not abort the rest of the trap
    trap - EXIT

    if [ "$STAGE_IN_DONE" = yes ] && [ "$STAGE_OUT_DONE" != yes ]; then
        echo "Job ending with exit code $rc before results were staged out: retrieving them now"
        stage_out
    fi

    # If the full stage-out failed, try to save at least the logs
    [ "$STAGE_OUT_DONE" != yes ] && retrieve_logs_to_master

    remove_local_case_dir
    gather_metrics
    echo "Script exit code: $rc"
    exit "$rc"
}

trap on_exit EXIT
# Without these, bash killed by a signal (time limit, scancel) skips the EXIT trap
trap 'echo "Received SIGTERM"; exit 143' TERM
trap 'echo "Received SIGINT";  exit 130' INT

#------------------------------------------------------------------------------
# HELYX simulation commands
#------------------------------------------------------------------------------