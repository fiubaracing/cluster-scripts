# System configurations
## Hostname
sms_name=sms
## Master node IPv4 address for internal network 
sms_ip=192.168.2.100
## Network interface for internal network
sms_eth_internal=eno1
eth_provision=eno1
sms_dhcp_start=192.168.2.101
sms_dhcp_end=192.168.2.255
## Internal network
internal_ip=192.168.2.0
internal_netmask=255.255.255.0
## NTP Configuration
ntp_server=time.nist.gov
bmc_username=NOTSET
bmc_password=NOTSET

# Nodes configurations
## Number of slave nodes
num_computes=11
## Node names, IPs, BMC IPs and MAC addresses in order
compute_regex=c*
compute_prefix=c
c_name=(c1 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12)
c_ip=(192.168.2.101 192.168.2.103 192.168.2.104 192.168.2.105 192.168.2.106 192.168.2.107 192.168.2.108 192.168.2.109 192.168.2.110 192.168.2.111 192.168.2.112)
c_mac=(9c:b6:54:0a:5d:ce 9c:b6:54:0a:5e:a6 9c:b6:54:0a:5d:ba 9c:b6:54:0a:46:ce 9c:b6:54:0a:5e:8a 9c:b6:54:0a:5e:ea 9c:b6:54:0a:5d:fe 9c:b6:54:0a:45:be 9c:b6:54:0a:47:3a 9c:b6:54:0a:44:d6 9c:b6:54:0a:44:6e)
c_bmc=NOTSET
# System configurations
## Utilities installation path
REPO_PATH=/opt/ohpc/pub/apps
## CFD Data LVM configurations
CFD_DATA_MOUNT_DIR=/mnt/cfd
CFD_DATA_LVM_NAME=cfd
CFD_DATA_LVM=/dev/mapper/cfd-lv_storage
# SLURM configurations
nhc_healtcheck_interval=30
## Specs for each node
real_memory=80000
sockets=2
cores_per_socket=8
threads_per_core=1
# Email configurations
## Something like re_....
RESEND_API_KEY=
RESEND_VERIFIED_DOMAIN=clusterfiuba.com.ar
# IPMI configurations
IPMI_USERNAME=Administrator
IPMI_PASSWORD=
IPMI_IPADDR=10.2.1.
IPMI_PROTO=lanplus
IPMI_INTERFACE=eno1
IPMI_NETMASK=(24 255.255.255.0)
# Cloudflared configurations
CLOUDFLARED_TUNNEL_TOKEN=